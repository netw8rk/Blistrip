# =============================================================================
# Blistrip Environment Configuration
# =============================================================================
# Copy this file to .env.local and fill in the values you need.
# Only OPENAI_API_KEY is required for basic functionality.
# All other keys are optional — the app degrades gracefully without them.
# =============================================================================

# --- AI Provider (Required for AI-powered trips) ---
OPENAI_API_KEY=

# --- Google Places API (Optional primary POI source) ---
# Get your key at: https://console.cloud.google.com/apis/credentials
# Enable: Places API (New) at https://console.cloud.google.com/apis/library/places-backend.googleapis.com
# When set, Google Places is used for destination search, place discovery, photos, and maps.
# OpenStreetMap is only used if this key is missing or a Google request returns nothing.
# Place photos need Places API (New) with the Photos field allowed on this key, plus billing.
GOOGLE_PLACES_API_KEY=

# --- Hotel Provider (Optional: enables real hotel search) ---
# Amadeus: https://developers.amadeus.com/
AMADEUS_API_KEY=
AMADEUS_API_SECRET=

# Booking.com: https://developers.booking.com/ (requires affiliate partnership)
# BOOKING_API_KEY=
# BOOKING_AFFILIATE_ID=

# --- Activity Provider (Optional: enables bookable tours/experiences) ---
# Viator: https://docs.viator.com/
VIATOR_API_KEY=

# --- Analytics (Optional) ---
# Vercel Analytics is included via @vercel/analytics and activates on Vercel.
# No extra key is required for page views. Custom events use lib/analytics.ts.

# --- Pipeline debug (Optional, development only) ---
# Set to 1 to attach pipelineDebug (queries, scores, filter counts) on trip JSON
# and print a detailed candidate-pool dump in the server console.
# BLISTRIP_DEBUG_PIPELINE=1

# =============================================================================
# IMPORTANT: Never expose server-only secrets to the browser.
# Variables prefixed with NEXT_PUBLIC_ are sent to the client.
# None of the variables above should use that prefix.
# =============================================================================
